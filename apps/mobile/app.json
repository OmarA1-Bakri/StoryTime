{
  "expo": {
    "name": "StoryTime",
    "slug": "storytime",
    "scheme": "storytime",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "@livekit/react-native-expo-plugin"],
    "ios": {
      "bundleIdentifier": "com.omarbakri.storytime",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "StoryTime uses the camera during private family story calls.",
        "NSMicrophoneUsageDescription": "StoryTime uses the microphone during private family story calls."
      }
    },
    "android": {
      "package": "com.omarbakri.storytime",
      "versionCode": 1,
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "adaptiveIcon": { "backgroundColor": "#100b17" }
    }
  }
}
