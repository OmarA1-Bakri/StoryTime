{
  "name": "@storytime/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No mobile tests yet\"",
    "test:unit": "echo \"No mobile unit tests yet\"",
    "test:e2e": "echo \"No mobile e2e tests yet\"",
    "build": "pnpm build:android && pnpm build:ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@livekit/react-native": "^2.11.1",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.1",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "^53.0.0",
    "expo-constants": "^17.0.0",
    "expo-dev-client": "^5.0.0",
    "expo-linking": "^7.0.0",
    "expo-local-authentication": "^16.0.0",
    "expo-notifications": "^0.31.0",
    "expo-router": "^5.0.0",
    "expo-secure-store": "^14.0.0",
    "livekit-client": "^2.20.1",
    "react": "19.0.0",
    "react-hook-form": "^7.53.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
