# App
APP_ENV=development
APP_NAME=StoryTime
APP_SCHEME=storytime
EXPO_PUBLIC_STORYTIME_API_URL=http://localhost:3000
# Private-beta only. Replace with authenticated token issuance before public launch.
EXPO_PUBLIC_STORYTIME_BETA_ACCESS_KEY=
STORYTIME_BETA_ACCESS_KEY=

# Convex
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=

# LiveKit
LIVEKIT_URL=
EXPO_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RECORDING_MODE=mock

# Object Storage: R2-compatible S3 API
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
R2_BUCKET_PRIVATE=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
STORAGE_MODE=local
STORAGE_PROVIDER=local

# Local S3-compatible storage
LOCAL_S3_ENDPOINT=http://localhost:9000
LOCAL_S3_ACCESS_KEY=minioadmin
LOCAL_S3_SECRET_KEY=minioadmin
LOCAL_S3_BUCKET=storytime-dev

# AI Providers
AI_MODE=mock
STT_PROVIDER=mock
STORY_PROVIDER=mock
IMAGE_PROVIDER=mock
SAFETY_PROVIDER=mock
GROQ_API_KEY=
FAL_KEY=
OPENAI_API_KEY=

# Verification
VPC_PROVIDER=mock
VPC_WEBHOOK_SECRET=
VPC_PROVIDER_API_KEY=

# Billing
BILLING_PROVIDER=mock
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics / Monitoring
ANALYTICS_PROVIDER=local
POSTHOG_KEY=
SENTRY_DSN=

# Worker
WORKER_POLL_INTERVAL_MS=5000
COMPOSITION_CONCURRENCY=1
FFMPEG_PATH=
